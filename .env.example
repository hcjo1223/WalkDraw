# .env.local 로 복사해서 사용하세요.
# Google 로그인: Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > OAuth 2.0 클라이언트 ID(웹 애플리케이션)
# 클라이언트 ID는 공개돼도 되는 값입니다(비밀번호 아님). 서버(server/)의 GOOGLE_CLIENT_ID와 같아야 해요.
VITE_GOOGLE_CLIENT_ID=

# 로그인·동기화 API 주소 — 기본값은 .env 에 있음. 로컬 서버로 테스트하려면:
# VITE_API_URL=http://localhost:8787
